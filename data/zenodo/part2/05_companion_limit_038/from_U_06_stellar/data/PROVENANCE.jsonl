{"file": "gaia_100pc_bprp_1.54_1.94.ecsv", "service": "Gaia archive TAP https://gea.esac.esa.int/tap-server/tap", "query": "SELECT source_id, parallax, parallax_error, phot_g_mean_mag, phot_bp_mean_mag, phot_rp_mean_mag, bp_rp, ruwe, phot_bp_rp_excess_factor, ipd_frac_multi_peak, ipd_gof_harmonic_amplitude, non_single_star, duplicated_source, radial_velocity, radial_velocity_error, rv_chisq_pvalue, rv_nb_transits, rv_renormalised_gof, has_xp_continuous FROM gaiadr3.gaia_source WHERE parallax > 10 AND parallax_over_error > 20 AND bp_rp BETWEEN 1.54 AND 1.94 AND phot_bp_mean_mag IS NOT NULL AND phot_rp_mean_mag IS NOT NULL", "utc": "2026-09-25T12:06:56.707921+00:00", "sha256": "020a66bc2567a94e2f461b51b0779bb9887aab8ad3cd4777dfbb3b7af581bcb0", "note": "local comparison sample for CMD overluminosity"}
{"file": "gaia_100pc_bprp_1.64_1.84_2mass_allwise.ecsv", "service": "Gaia archive TAP https://gea.esac.esa.int/tap-server/tap", "query": "SELECT g.source_id, g.parallax, g.parallax_error, g.phot_g_mean_mag, g.bp_rp, g.ruwe, g.non_single_star, t.j_m, t.j_msigcom, t.h_m, t.h_msigcom, t.ks_m, t.ks_msigcom, t.ph_qual AS tm_qual, w.w1mpro, w.w1mpro_error, w.w2mpro, w.w2mpro_error, w.w3mpro, w.w3mpro_error, w.w4mpro, w.w4mpro_error, w.cc_flags, w.ext_flag, w.ph_qual AS w_qual, xw.angular_distance AS w_sep FROM gaiadr3.gaia_source AS g JOIN gaiadr3.allwise_best_neighbour AS xw ON xw.source_id = g.source_id JOIN gaiadr1.allwise_original_valid AS w ON w.allwise_oid = xw.allwise_oid JOIN gaiadr3.tmass_psc_xsc_best_neighbour AS xt ON xt.source_id = g.source_id JOIN gaiadr3.tmass_psc_xsc_join AS tj ON tj.clean_tmass_psc_xsc_oid = xt.clean_tmass_psc_xsc_oid JOIN gaiadr1.tmass_original_valid AS t ON t.designation = tj.original_psc_source_id WHERE g.parallax > 10 AND g.parallax_over_error > 20 AND g.bp_rp BETWEEN 1.64 AND 1.84", "utc": "2026-09-25T12:07:58.309321+00:00", "sha256": "e089ab9ac84a7602d43ff9d2b30b6154ea1c085f43e0c9e744fb5946b0cbf13d", "note": "empirical photospheric IR colour locus"}

#   datatype: int16
#   description: Flag indicating the availability of additional information in the various Non-Single Star tables
#   meta: !!omap
#   - {ucd: meta.code.status}
# - name: j_m
#   unit: mag
#   datatype: float32
#   description: "Default J-band magnitude.  \nIn case of a source not detected in the J-band, it is an upper limit and\nthe corresponding\
#     \ total photometric uncertainty is NULL.  \nIn case of a source detected in the J-band and with no useful brightness\nestimate,\
#     \ it is set to NULL."
#   meta: !!omap

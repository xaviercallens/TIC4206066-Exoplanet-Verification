# 
#     (i.e. the source is not detected, or inconsistently deblended in the
# 
#     H-band).'
#   meta: !!omap
#   - {ucd: stat.error;phot.mag;em.IR.H}
# - name: ks_m
#   unit: mag
#   datatype: float32
#   description: "Default Ks-band magnitude.  \nIn case of a source not detected in the Ks-band, it is an upper limit\nand the corresponding\
#     \ total photometric uncertainty is NULL.  \nIn case of a source detected in the Ks-band and with no useful\nbrightness estimate,\
#     \ it is set to NULL."
#   meta: !!omap
#   - {ucd: phot.mag;em.IR.K}
# - name: ks_msigcom
#   unit: mag
